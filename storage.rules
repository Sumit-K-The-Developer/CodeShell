rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isChatParticipant(chatId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    function canReadStory(ownerId, storyId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/stories/$(storyId))
        && (request.auth.uid == ownerId
          || request.auth.uid in firestore.get(/databases/(default)/documents/stories/$(storyId)).data.audienceUserIds);
    }

    match /chats/{chatId}/{messageId}/{fileName} {
      allow read: if request.auth != null && isChatParticipant(chatId);
      allow write: if request.auth != null && isChatParticipant(chatId);
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /stories/{ownerId}/{storyId}/{fileName} {
      allow read: if canReadStory(ownerId, storyId);
      allow create, update: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
