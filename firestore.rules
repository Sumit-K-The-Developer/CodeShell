rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isReservedUsername(username) {
      return username == '8787';
    }

    function isValidDigitUsername(username) {
      return username.matches('^[0-9]+$')
        && username.size() >= 4
        && username.size() <= 10;
    }

    function isChatParticipant(chatId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function otherParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return chat.participants[0] == request.auth.uid
        ? chat.participants[1]
        : chat.participants[0];
    }

    function isBlockedByOther(chatId) {
      let otherId = otherParticipant(chatId);
      return request.auth.uid in get(/databases/$(database)/documents/users/$(otherId)).data.blockedUsers;
    }

    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && isValidDigitUsername(username)
        && !isReservedUsername(username);
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.username is string
        && isValidDigitUsername(request.resource.data.username)
        && !isReservedUsername(request.resource.data.username);
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1];

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId)
          && !isBlockedByOther(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.content is string
          && request.resource.data.delivered == false
          && request.resource.data.read == false
          && request.resource.data.deleted == false
          && request.resource.data.seenBy is map
          && request.auth.uid in request.resource.data.seenBy
          && request.resource.data.timestamp is timestamp
          && request.resource.data.unseenExpiresAt is timestamp;

        allow update: if isChatParticipant(chatId) && (
          (request.auth.uid == resource.data.senderId
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.deleted == true)
          ||
          (request.auth.uid == resource.data.senderId
            && resource.data.deleted == false
            && resource.data.type == 'text'
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.deleted == false
            && request.resource.data.type == 'text'
            && request.resource.data.content is string
            && request.resource.data.timestamp == resource.data.timestamp
            && request.time < resource.data.timestamp + duration.value(900, 's')
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['content', 'editedAt']))
          ||
          (request.resource.data.senderId == resource.data.senderId
            && request.resource.data.content == resource.data.content
            && request.resource.data.deleted == resource.data.deleted
            && request.resource.data.type == resource.data.type
            && request.resource.data.timestamp == resource.data.timestamp
            && request.resource.data.unseenExpiresAt == resource.data.unseenExpiresAt
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['delivered', 'read', 'seenBy', 'expiresAt', 'hiddenBy']))
          ||
          (isChatParticipant(chatId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy'])
            && request.auth.uid in request.resource.data.hiddenBy
            && request.resource.data.hiddenBy[request.auth.uid] is timestamp)
        );

        allow delete: if isChatParticipant(chatId);
      }
    }

    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /stories/{storyId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
          || request.auth.uid in resource.data.audienceUserIds);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.audienceUserIds is list
        && request.resource.data.audienceUserIds.size() > 0
        && request.resource.data.audienceChatIds is list
        && request.resource.data.audienceChatIds.size() > 0
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.viewedBy is map
        && request.resource.data.textOverlay is map;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        ||
        (request.auth.uid in resource.data.audienceUserIds
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.audienceUserIds == resource.data.audienceUserIds
          && request.resource.data.audienceChatIds == resource.data.audienceChatIds
          && request.resource.data.mediaUrl == resource.data.mediaUrl
          && request.resource.data.mediaType == resource.data.mediaType
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.textOverlay == resource.data.textOverlay
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
          && request.resource.data.viewedBy[request.auth.uid] is timestamp)
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    function isCallParticipant(callId) {
      let call = get(/databases/$(database)/documents/calls/$(callId)).data;
      return request.auth != null
        && (request.auth.uid == call.callerId || request.auth.uid == call.calleeId);
    }

    match /calls/{callId} {
      allow read: if request.auth != null
        && (resource == null
          || request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerId
        && isChatParticipant(request.resource.data.chatId)
        && request.resource.data.calleeId == otherParticipant(request.resource.data.chatId)
        && request.resource.data.state == 'ringing';

      allow update: if request.auth != null
        && (request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId);

      match /candidates/{candidateId} {
        allow read, create: if isCallParticipant(callId);
      }
    }

    match /config/app {
      allow read: if true;
      allow write: if false;
    }
  }
}
